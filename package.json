{
  "name": "omp-emphasis",
  "version": "0.4.3",
  "description": "Colored status pills with icons, labeled headings and colored bold for assistant replies in omp's terminal, with the rules that teach the agent to write them. A port of pi-emphasis.",
  "license": "MIT",
  "type": "module",
  "keywords": ["omp", "oh-my-pi", "markdown", "terminal", "pills"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrm007/omp-emphasis.git"
  },
  "omp": {
    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "tern", "README.md", "LICENSE"],
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^19.2.1",
    "@oh-my-pi/pi-tui": "^19.2.1",
    "bun-types": "^1.4.4",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test"
  }
}
